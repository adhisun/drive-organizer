# Google Apps Script Web App URL (Zero Google Cloud Console required!)
# 1) Create a new script at https://script.google.com
# 2) Paste apps-script/Code.gs, apps-script/Bridge.html, and apps-script/appsscript.json
# 3) Click Deploy -> New deployment -> Web app (Execute as: User accessing the web app)
APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Local development server port
PORT=5173
