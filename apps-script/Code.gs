/**
 * Drive Nano Categorizer — Zero-GCP Google Apps Script Sign-In Bridge (V8)
 *
 * Security & Governance Guarantees:
 * - Executes strictly as USER_ACCESSING (the signed-in Chrome user's own Google session).
 * - Zero Google Cloud Console project or OAuth Client ID required.
 * - Strictly validates that `return_to` points ONLY to http://localhost or http://127.0.0.1.
 * - Zero external HTTP egress calls and zero hardcoded secrets.
 */

var ALLOWED_LOCALHOST_REGEX = /^http:\/\/(localhost|127\.0\.0\.1)(:\d{2,5})?(\/[a-zA-Z0-9._\/-]*)?$/;
var ALLOWED_STATE_REGEX = /^[a-zA-Z0-9_-]{8,128}$/;
var DEFAULT_LOCAL_RETURN = 'http://localhost:5173/';

/**
 * Web App entry point (`GET https://script.google.com/macros/s/<ID>/exec`).
 * Google automatically authenticates the user via their active Chrome Google session.
 */
function doGet() {
  return HtmlService.createHtmlOutputFromFile('Bridge')
    .setTitle('Sign in — Drive Nano Categorizer')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/**
 * Invoked asynchronously by Bridge.html via `google.script.run`.
 * Validates localhost callback parameters (falling back safely if Google's first-time OAuth
 * approval screen stripped query parameters) and returns a short-lived Drive session URL.
 *
 * @param {string} returnTo - Localhost return URL (e.g. "http://localhost:5173/")
 * @param {string} state - CSRF state nonce generated by the localhost app
 * @param {string} popup - "1" when opened in a popup window
 * @return {{ email: string, displayName: string, callbackUrl: string, scopes: string }}
 */
function getBridgeAuthPayload(returnTo, state, popup) {
  // If Google's first-time "Review Permissions -> Allow" redirect dropped URL query params,
  // default safely to http://localhost:5173/ in popup mode.
  var cleanReturnTo = String(returnTo || '').trim() || DEFAULT_LOCAL_RETURN;
  var cleanState = String(state || '').trim() || 'gas_first_auth';
  var cleanPopup = String(popup || '').trim() || (returnTo ? '' : '1');

  if (!ALLOWED_LOCALHOST_REGEX.test(cleanReturnTo)) {
    throw new Error(
      'Blocked return_to URL. Only http://localhost or http://127.0.0.1 origins are permitted.'
    );
  }

  if (!ALLOWED_STATE_REGEX.test(cleanState)) {
    throw new Error('Invalid CSRF state token format.');
  }

  var accessToken = ScriptApp.getOAuthToken();
  var email = '';
  var displayName = '';
  var photoLink = '';

  // Query Drive v3 Advanced Service to verify Drive v3 access and fetch user profile
  try {
    var about = Drive.About.get({ fields: 'user(displayName,emailAddress,photoLink)' });
    if (about && about.user) {
      email = about.user.emailAddress || '';
      displayName = about.user.displayName || '';
      photoLink = about.user.photoLink || '';
    }
  } catch (err) {
    // Fallback to Session email if Drive.About is still warming up
  }

  if (!email) {
    try {
      email = Session.getActiveUser().getEmail() || '';
    } catch (err) {
      email = '';
    }
  }

  var grantedScope = 'https://www.googleapis.com/auth/drive.readonly';
  var separator = cleanReturnTo.indexOf('?') === -1 ? '?' : '&';
  var baseReturn = cleanPopup === '1' ? cleanReturnTo + separator + 'popup=1' : cleanReturnTo;

  var hashParts = [
    'access_token=' + encodeURIComponent(accessToken),
    'expires_in=3300',
    'scope=' + encodeURIComponent(grantedScope),
    'state=' + encodeURIComponent(cleanState),
    'auth_source=gas'
  ];
  if (email) {
    hashParts.push('email=' + encodeURIComponent(email));
  }
  if (displayName) {
    hashParts.push('name=' + encodeURIComponent(displayName));
  }
  if (photoLink) {
    hashParts.push('photo=' + encodeURIComponent(photoLink));
  }

  return {
    email: email,
    displayName: displayName,
    callbackUrl: baseReturn + '#' + hashParts.join('&'),
    scopes: grantedScope
  };
}
